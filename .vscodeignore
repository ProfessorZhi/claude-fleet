# ── Claude Fleet VSIX packaging exclusions ──────────────────────────
# Keep ONLY what the installed extension needs at runtime:
#   dist/extension.js, dist/cli.js, dist/hooks/, dist/assets/,
#   dist/webview/, package.json, README.md, LICENSE,
#   THIRD_PARTY_NOTICES.md, CHANGELOG.md, assets/branding/icon.png
#
# Everything else (sources, specs, docs, tests, CI, dev tooling) stays out.
# Verify with: npx vsce ls

# Project knowledge / agent layer
.agent/
.claude/
docs/
AGENTS.md
CLAUDE.md

# Sources (compiled to dist/)
adapters/
core/
server/
webview-ui/
scripts/
esbuild.js
eslint.config.mjs
eslint-rules/
knip.json
tsconfig.json
tsconfig.*.json

# Tests / E2E
e2e/
coverage/
allure-results/
playwright-report/
test-results/
**/__tests__/
**/*.test.*
**/*.spec.*

# VCS / CI
.git/
.gitignore
.git-blame-ignore-revs
.github/
.husky/
.gitleaks.toml
.prettierignore
.prettierrc*

# Dev artifacts
node_modules/
.nvmrc
.vscode/
**/*.map
*.tsbuildinfo

# Misc (runtime does not need)
icon.png.tmp
*.log
