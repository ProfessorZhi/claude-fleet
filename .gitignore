# ===== 环境与密钥（绝不入库） =====
.env
.env.*
!.env.example
*.env
*.env.*

# 任何带密钥痕迹的文件名都跳过
*.pem
*.key
*id_rsa*
*id_ed25519*

# ===== 依赖与构建产物（Node / TypeScript 通用） =====
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# ===== agentmetrics Python runtime =====
agentmetrics/.local/*
!agentmetrics/.local/.gitkeep
agentmetrics/**/__pycache__/
agentmetrics/**/*.py[cod]
agentmetrics/**/*.egg-info/
agentmetrics/.venv/
agentmetrics/venv/
agentmetrics/.pytest_cache/
agentmetrics/htmlcov/
agentmetrics/.coverage

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/logs

# ===== 编辑器 / IDE =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.vscode-test/
.idea/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db

# ===== Claude / Agent 本地缓存 =====
# Claude Fleet 的 .claude/ 顶层目录里：
#   skills/  rules/   —— 入库（适配层资产）
#   cache/   state/   sessions/ —— 不入库（本地运行时）
.claude/cache/
.claude/state/
.claude/sessions/
/.claude/

# 上游 Pixel Agents 也有 .mcp.json 等本地工具配置，不入库
.mcp.json

# ===== E2E 与测试产物 =====
test-results/
playwright-report/
allure-results/
allure-report/
.playwright-mcp/

# ===== 打包产物 =====
# release/ 是本地 Alpha artifact 目录（npm run vsix 固定输出到
# release/claude-fleet-<version>.vsix）。VSIX 是 Release Artifact，
# 通过 GitHub Releases 发布，不提交到 Git。
*.vsix
*.map
/release/

# ===== 项目本地工具 / 临时目录 =====
/sprites-export
/.vercel/
/.worktrees
agent-orchestrator.yaml
.ao/
.serena/
/tasks/

# ===== 本地笔记（不入库） =====
/notes/
/docs/e2e-*.md
!/docs/e2e-claude-mocking.md

# ===== 测试与临时 =====
*.tmp
*.bak
.cache/

# VS Code 隔离测试运行时（--extensions-dir .tmp-vscode-alpha，用完即弃）
.tmp-vscode-alpha/

# 字面 %USERPROFILE% 目录（Windows 上环境变量未展开时的误产物）
/%USERPROFILE%/

# ===== 注意：以下目录**故意**保留在仓库中 =====
# AGENTS.md        —— 所有 Agent 的统一入口
# CLAUDE.md        —— Claude Code 适配层
# docs/            —— 项目信息（与 Pixel Agents 的 docs/ 不冲突；上游 docs/ 在另一目录）
# .agent/          —— Agent 工作流与知识
# .claude/         —— Claude Code 适配层（但忽略其内部缓存 / 状态目录）

# 显式 Force-Include（防止被任何上层 .gitignore 影响）
!AGENTS.md
!CLAUDE.md
!README.md
!docs/
!.agent/
!.claude/skills/
!.claude/rules/
!.claude/skills/**
!.claude/rules/**
